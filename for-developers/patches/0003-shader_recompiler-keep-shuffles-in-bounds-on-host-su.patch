From c4b4b572110ace9ca09b5a8366039351d55960ee Mon Sep 17 00:00:00 2001
From: Fritchii Intel fixes <intel-fixes@users.noreply.invalid>
Date: Wed, 11 Nov 2026 23:11:51 +0100
Subject: [PATCH 03/14] shader_recompiler: keep shuffles in bounds on host
 subgroups narrower than the warp

Intel's fragment and vertex shaders cannot be pinned to 32 lanes (SIMD8/16). A guest shuffle
from lane 16-31 (xor 16 butterfly, SHFL.DOWN 16) then reads a non-existent invocation:
undefined, can be NaN, which bloom spreads into flashes.

New Profile::warp_size_potentially_smaller_than_guest (min subgroup size < 32: Intel only). With
it, shuffling shaders load SubgroupSize, and ShuffleIndex/Down/Butterfly treat a source lane at
or past it as out of range (own value kept, in-bounds predicate false), as the guest does for a
lane outside its clamp. ShuffleUp cannot leave the subgroup.

Tested: Arc B580, flashing lights gone. SPIR-V unchanged on NVIDIA and AMD (flag false).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../backend/spirv/emit_spirv_warp.cpp         | 20 ++++++++++++++++---
 .../backend/spirv/spirv_emit_context.cpp      |  6 ++++++
 .../backend/spirv/spirv_emit_context.h        |  3 +++
 src/shader_recompiler/profile.h               |  3 +++
 .../renderer_vulkan/vk_pipeline_cache.cpp     |  1 +
 src/video_core/vulkan_common/vulkan_device.h  |  9 +++++++++
 6 files changed, 39 insertions(+), 3 deletions(-)

diff --git a/src/shader_recompiler/backend/spirv/emit_spirv_warp.cpp b/src/shader_recompiler/backend/spirv/emit_spirv_warp.cpp
index 999f008ca..c53c8e8e4 100644
--- a/src/shader_recompiler/backend/spirv/emit_spirv_warp.cpp
+++ b/src/shader_recompiler/backend/spirv/emit_spirv_warp.cpp
@@ -90,6 +90,17 @@ Id GuestLane(EmitContext& ctx, Id index) {
     return ctx.OpBitwiseAnd(ctx.U32[1], index, ctx.Const(31U));
 }
 
+// A guest lane past a narrower host subgroup (Intel's SIMD16 fragment shaders) has no host
+// invocation, and shuffling from it is undefined: it is treated as out of the shuffle's range, so
+// the lane keeps its own value and the in-bounds predicate is false.
+Id InHostSubgroup(EmitContext& ctx, Id in_range, Id src_thread_id) {
+    if (!Sirit::ValidId(ctx.subgroup_size)) {
+        return in_range;
+    }
+    const Id size{ctx.OpLoad(ctx.U32[1], ctx.subgroup_size)};
+    return ctx.OpLogicalAnd(ctx.U1, in_range, ctx.OpULessThan(ctx.U1, src_thread_id, size));
+}
+
 bool UseShuffleFallback(EmitContext& ctx) {
     return ctx.profile.has_broken_spirv_subgroup_shuffle ||
            (ctx.profile.has_broken_spirv_fragment_shuffle && ctx.stage == Stage::Fragment);
@@ -247,7 +258,8 @@ Id EmitShuffleIndex(EmitContext& ctx, IR::Inst* inst, Id value, Id index, Id cla
 
     const Id lhs{ctx.OpBitwiseAnd(ctx.U32[1], GuestLane(ctx, index), not_seg_mask)};
     const Id src_thread_id{ctx.OpBitwiseOr(ctx.U32[1], lhs, min_thread_id)};
-    const Id in_range{ctx.OpSLessThanEqual(ctx.U1, src_thread_id, max_thread_id)};
+    const Id in_range{InHostSubgroup(
+        ctx, ctx.OpSLessThanEqual(ctx.U1, src_thread_id, max_thread_id), src_thread_id)};
 
     SetInBoundsFlag(inst, in_range);
     if (!StageSupportsSubgroups(ctx)) {
@@ -291,7 +303,8 @@ Id EmitShuffleDown(EmitContext& ctx, IR::Inst* inst, Id value, Id index, Id clam
     const Id thread_id{EmitLaneId(ctx)};
     const Id max_thread_id{GetMaxThreadId(ctx, thread_id, clamp, segmentation_mask)};
     const Id src_thread_id{ctx.OpIAdd(ctx.U32[1], thread_id, delta)};
-    const Id in_range{ctx.OpSLessThanEqual(ctx.U1, src_thread_id, max_thread_id)};
+    const Id in_range{InHostSubgroup(
+        ctx, ctx.OpSLessThanEqual(ctx.U1, src_thread_id, max_thread_id), src_thread_id)};
 
     SetInBoundsFlag(inst, in_range);
     const Id shuffled{ShuffleRelative(ctx, value, delta, src_thread_id,
@@ -309,7 +322,8 @@ Id EmitShuffleButterfly(EmitContext& ctx, IR::Inst* inst, Id value, Id index, Id
     const Id thread_id{EmitLaneId(ctx)};
     const Id max_thread_id{GetMaxThreadId(ctx, thread_id, clamp, segmentation_mask)};
     const Id src_thread_id{ctx.OpBitwiseXor(ctx.U32[1], thread_id, mask)};
-    const Id in_range{ctx.OpSLessThanEqual(ctx.U1, src_thread_id, max_thread_id)};
+    const Id in_range{InHostSubgroup(
+        ctx, ctx.OpSLessThanEqual(ctx.U1, src_thread_id, max_thread_id), src_thread_id)};
 
     SetInBoundsFlag(inst, in_range);
     const Id shuffled{ctx.OpGroupNonUniformShuffleXor(ctx.U32[1], SubgroupScope(ctx), value, mask)};
diff --git a/src/shader_recompiler/backend/spirv/spirv_emit_context.cpp b/src/shader_recompiler/backend/spirv/spirv_emit_context.cpp
index 7e017593a..54e2c3eee 100644
--- a/src/shader_recompiler/backend/spirv/spirv_emit_context.cpp
+++ b/src/shader_recompiler/backend/spirv/spirv_emit_context.cpp
@@ -1735,6 +1735,12 @@ void EmitContext::DefineInputs(const IR::Program& program) {
         if (stage == Stage::Fragment) {
             Decorate(subgroup_local_invocation_id, spv::Decoration::Flat);
         }
+        if (info.uses_subgroup_shuffles && profile.warp_size_potentially_smaller_than_guest) {
+            subgroup_size = DefineInput(*this, U32[1], false, spv::BuiltIn::SubgroupSize);
+            if (stage == Stage::Fragment) {
+                Decorate(subgroup_size, spv::Decoration::Flat);
+            }
+        }
     }
     if (info.uses_fswzadd) {
         const Id f32_one{Const(1.0f)};
diff --git a/src/shader_recompiler/backend/spirv/spirv_emit_context.h b/src/shader_recompiler/backend/spirv/spirv_emit_context.h
index 019a34078..5aa6026f2 100644
--- a/src/shader_recompiler/backend/spirv/spirv_emit_context.h
+++ b/src/shader_recompiler/backend/spirv/spirv_emit_context.h
@@ -286,6 +286,9 @@ public:
     Id sample_id{};
     Id is_helper_invocation{};
     Id subgroup_local_invocation_id{};
+    /// SubgroupSize, when the host subgroup may be narrower than the guest warp and the program
+    /// shuffles (Profile::warp_size_potentially_smaller_than_guest).
+    Id subgroup_size{};
     Id subgroup_mask_eq{};
     Id subgroup_mask_lt{};
     Id subgroup_mask_le{};
diff --git a/src/shader_recompiler/profile.h b/src/shader_recompiler/profile.h
index e0a2e1cae..21a26a33a 100644
--- a/src/shader_recompiler/profile.h
+++ b/src/shader_recompiler/profile.h
@@ -67,6 +67,9 @@ struct Profile {
     bool support_storage_texel_buffer_array_nonuniform_indexing{};
 
     bool warp_size_potentially_larger_than_guest{};
+    /// Some stages may run in subgroups narrower than the guest's 32 lanes (Intel's SIMD8/16
+    /// fragment and vertex shaders): shuffles from lanes past the subgroup are kept in bounds.
+    bool warp_size_potentially_smaller_than_guest{};
 
     bool lower_left_origin_mode{};
     /// Fragment outputs have to be declared even if they are not written to avoid undefined values.
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index 1bb0d45e4..69d890652 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -788,6 +788,7 @@ PipelineCache::PipelineCache(Tegra::MaxwellDeviceMemoryManager& device_memory_,
             device.IsStorageTexelBufferArrayNonUniformIndexingSupported(),
 
         .warp_size_potentially_larger_than_guest = device.IsWarpSizePotentiallyBiggerThanGuest(),
+        .warp_size_potentially_smaller_than_guest = device.IsWarpSizePotentiallySmallerThanGuest(),
 
         .lower_left_origin_mode = false,
         .need_declared_frag_colors = false,
diff --git a/src/video_core/vulkan_common/vulkan_device.h b/src/video_core/vulkan_common/vulkan_device.h
index 3d80b9212..c128df151 100644
--- a/src/video_core/vulkan_common/vulkan_device.h
+++ b/src/video_core/vulkan_common/vulkan_device.h
@@ -565,6 +565,15 @@ FN_MAX_LIMIT_LIST
                control.minSubgroupSize <= GuestWarpSize && GuestWarpSize <= control.maxSubgroupSize;
     }
 
+    /// Returns true if a stage may run in subgroups narrower than the guest's warp (Intel runs
+    /// fragment and vertex shaders SIMD8 or SIMD16, and those cannot be given a size).
+    bool IsWarpSizePotentiallySmallerThanGuest() const {
+        const u32 min_size = extensions.subgroup_size_control
+                                 ? properties.subgroup_size_control.minSubgroupSize
+                                 : properties.subgroup_properties.subgroupSize;
+        return min_size != 0 && min_size < GuestWarpSize;
+    }
+
     /// Returns true if the device supports the provided subgroup feature.
     bool IsSubgroupFeatureSupported(VkSubgroupFeatureFlagBits feature) const {
         return properties.subgroup_properties.supportedOperations & feature;
-- 
